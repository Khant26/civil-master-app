# Copy to .env for local development (never commit .env).
# In production set these in the hosting dashboard (Render / Docker --env-file).

# --- Django core ---
# Required when DEBUG is off. Generate e.g. with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
# Extra hostnames, comma-separated (localhost, 127.0.0.1 and *.onrender.com are always allowed)
ALLOWED_HOSTS=

# --- Database / cache ---
# Postgres URL, e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME (SQLite is used when empty)
DATABASE_URL=
# Redis URL, e.g. redis://HOST:6379/0 (in-memory cache is used when empty)
REDIS_URL=

# --- Frontend / CORS / CSRF ---
# Public website (also hosts the /admin dashboard), e.g. https://www.civilmastersolution.com
FRONTEND_URL=
# Optional separate admin origin
ADMIN_URL=
# Extra allowed origins, comma-separated
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Allow any https://*.vercel.app origin (preview deployments)
CORS_ALLOW_VERCEL_PREVIEWS=True
# Keep True behind an HTTPS proxy that sets X-Forwarded-Proto
SECURE_SSL_REDIRECT=True

# --- Media files ---
# Defaults: ./media locally, /opt/render/project/data/media on Render, /app/media in Docker
MEDIA_ROOT=

# --- Chatbot ---
GEMINI_API_KEY=

# --- Email (request-form auto replies and alerts) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_ALERT_EMAIL=

# --- Optional: superuser created by build.sh (python manage.py create_superuser) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
